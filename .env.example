# Copy to .env and adjust. Never commit .env.

# Where the app stores its database, imported datasets and cache (native dev).
# Defaults to %LOCALAPPDATA%\DataExplorer on Windows.
# DATA_EXPLORER_HOME=C:\path\to\workspace

# Docker: host folder mounted read-only at /data (importable via "Browse"). Default: ./data
# DATA_DIR=C:\path\to\your\datasets
